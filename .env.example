# Alamat backend dilihat dari BROWSER.
#
# Biarkan relatif. Frontend memproxy /api dan /uploads ke backend (lihat
# rewrites di next.config.ts), jadi permintaan pergi ke origin halaman sendiri
# lalu diteruskan. Efeknya: tidak ada CORS, tidak ada risiko mixed content saat
# situs disajikan lewat HTTPS, dan cookie `jwt` menjadi same-origin.
#
# Nilainya di-inline saat build, jadi setelah diubah `pnpm dev` harus
# dijalankan ulang. Bentuk absolut (http://localhost:8080/api) masih dihormati
# bila frontend memang perlu dijalankan lepas dari backend.
NEXT_PUBLIC_API_BASE_URL=/api

# Tujuan proxy, dilihat dari PROSES NEXT — bukan browser.
#
# Di mesin pengembang backend biasanya berjalan di host, jadi localhost benar.
# Di dalam Docker nilainya diisi lewat build arg (lihat .env.docker) dan
# menunjuk nama service `backend`.
BACKEND_ORIGIN=http://localhost:8080
